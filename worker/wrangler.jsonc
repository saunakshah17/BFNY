{
  "name": "bfny-game",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {"bindings":[{"name":"ROOM","class_name":"GameRoom"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["GameRoom"]}],
  "d1_databases":[{"binding":"DB","database_name":"bfny","database_id":"REPLACE_WITH_D1_DATABASE_ID","migrations_dir":"../migrations"}],
  "r2_buckets":[{"binding":"PHOTOS","bucket_name":"bfny-photos"}],
  "vars":{"GOOGLE_MAPS_BROWSER_KEY":"REPLACE_WITH_RESTRICTED_BROWSER_KEY"}
}
